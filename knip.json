{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": true,
  "ignoreDependencies": ["tsrs"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error"
  },
  "ignoreIssues": {
    "apps/*/src/features/*/routes.ts": ["types"]
  },
  "workspaces": {
    "apps/*": {
      "entry": ["src/app/**/*.{ts,tsx}!", "src/pages/**/*.{ts,tsx,astro}!"],
      "includeEntryExports": false
    }
  }
}
