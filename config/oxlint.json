{
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": { "correctness": "error" },
  "env": { "builtin": true },
  "options": { "typeAware": true, "typeCheck": true, "reportUnusedDisableDirectives": "error" },
  "jsPlugins": ["@mapringg/standard/oxlint"],
  "rules": {
    "standard/zod": "error",
    "standard/memo": "error",
    "standard/timer": "error",
    "standard/redis": "error",
    "standard/ai": "error",
    "standard/ui": "error",
    "standard/swr": "error",
    "standard/env": "error",
    "standard/json": "error",
    "standard/log": "error",
    "standard/format": "error",
    "standard/effect": "error",
    "standard/effect-cleanup": "error",
    "standard/client-data": "error",
    "standard/names": "error",

    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "typescript/no-restricted-types": [
      "error",
      { "types": { "any": { "message": "Name the domain type or parse external data at its boundary." } } }
    ],
    "no-restricted-properties": [
      "error",
      { "object": "Reflect", "property": "apply", "message": "Call the typed function directly. Model dynamic dispatch behind a named interface." },
      { "object": "Reflect", "property": "get", "message": "Use typed property access. Parse dynamic input into a named domain type before reading it." }
    ]
  }
}
