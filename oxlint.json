{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y",
    "nextjs",
    "vitest"
  ],
  "jsPlugins": ["./src/plugin/index.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "rules": {
    "standard/feature-imports": "error",
    "standard/hono": "error",
    "standard/next-data": "error",
    "standard/next-routes": "error",
    "standard/no-chained-assertions": "error",
    "standard/no-comments": "error",
    "standard/no-return-types": "error",
    "standard/no-typeof": "error",
    "standard/owners": "error",
    "standard/params": "error",
    "standard/query-client": "error",
    "standard/reducer": "error",
    "standard/repo-shape": "error",
    "standard/server-actions": "error",
    "standard/style-prop": "error",
    "standard/tests": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.{1,2}(/|$)",
            "message": "Import through the #/ alias from package.json imports."
          },
          {
            "regex": "^@/",
            "message": "Import through the #/ alias from package.json imports; @/ tsconfig paths break when another package type checks this file."
          }
        ]
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
        "ignore": ["^_layout\\.", "^__root\\.", "^\\+", "^\\[", "^\\$", "\\.d\\.ts$"]
      }
    ],
    "react/jsx-no-literals": [
      "error",
      {
        "restrictedAttributes": ["placeholder", "aria-label", "title", "alt"],
        "allowedStrings": ["", "-", "–", "—", "/", "|", "·", "•", ":", ",", ".", "…", "(", ")", "+", "×", "%", "#", "*"]
      }
    ],
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": false
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "import/namespace": "off",
    "import/no-namespace": "off",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-max-depth": "off",
    "eslint/sort-keys": "off",
    "eslint/sort-imports": "off",
    "eslint/func-style": "off",
    "eslint/one-var": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/no-ternary": "off",
    "eslint/curly": "off",
    "eslint/no-undefined": "off",
    "eslint/no-void": "off",
    "eslint/require-await": "off",
    "eslint/no-console": "off",
    "eslint/no-underscore-dangle": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/require-await": "off",
    "typescript/explicit-member-accessibility": "off",
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-optional-chaining": "off",
    "unicorn/no-null": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/prefer-top-level-await": "off",
    "promise/valid-params": "off",
    "node/no-process-env": "off",
    "node/no-top-level-await": "off",
    "vitest/require-test-timeout": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/require-top-level-describe": "off",
    "vitest/require-hook": "off",
    "vitest/no-hooks": "off",
    "vitest/prefer-describe-function-title": "off",
    "vitest/consistent-test-it": [
      "error",
      {
        "fn": "test",
        "withinDescribe": "test"
      }
    ],
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "promise/prefer-await-to-then": "off",
    "unicorn/no-useless-undefined": "off",
    "node/callback-return": "off",
    "typescript/consistent-type-definitions": "off",
    "eslint/new-cap": [
      "error",
      {
        "capIsNew": false
      }
    ],
    "eslint/class-methods-use-this": [
      "error",
      {
        "enforceForClassFields": false
      }
    ],
    "typescript/promise-function-async": "off",
    "unicorn/no-document-cookie": "off",
    "vitest/valid-title": [
      "error",
      {
        "allowArguments": true
      }
    ],
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/prefer-called-times": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "eslint/prefer-destructuring": [
      "error",
      {
        "VariableDeclarator": {
          "array": false,
          "object": true
        },
        "AssignmentExpression": {
          "array": false,
          "object": false
        }
      }
    ],
    "react/forbid-component-props": "off",
    "import/no-nodejs-modules": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "node/no-sync": ["error", { "ignores": ["flushSync"] }],
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "react/incompatible-library": "off"
  },
  "overrides": [
    {
      "files": ["**/src/app/**", "**/src/pages/**", "**/*.config.*"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/src/app/**/page.tsx", "**/src/app/**/layout.tsx"],
      "rules": {
        "react/only-export-components": [
          "error",
          {
            "allowExportNames": [
              "dynamic",
              "dynamicParams",
              "revalidate",
              "fetchCache",
              "runtime",
              "preferredRegion",
              "maxDuration",
              "experimental_ppr",
              "instant",
              "prefetch",
              "ensureStatic",
              "metadata",
              "generateMetadata",
              "viewport",
              "generateViewport",
              "generateStaticParams",
              "unstable_dynamicStaleTime"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/app/**/opengraph-image.tsx",
        "**/src/app/**/twitter-image.tsx",
        "**/src/app/**/icon.tsx",
        "**/src/app/**/apple-icon.tsx"
      ],
      "rules": {
        "react/only-export-components": [
          "error",
          {
            "allowExportNames": [
              "alt",
              "size",
              "contentType",
              "generateImageMetadata",
              "dynamic",
              "dynamicParams",
              "revalidate",
              "fetchCache",
              "runtime",
              "preferredRegion",
              "maxDuration"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/proxy.ts", "**/src/middleware.ts"],
      "rules": {
        "unicorn/prefer-string-raw": "off"
      }
    },
    {
      "files": ["**/*.config.js", "**/*.config.cjs", "**/*.config.mjs"],
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off",
        "unicorn/prefer-module": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-var-requires": "off",
        "import/no-anonymous-default-export": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "unicorn/require-module-specifiers": "off",
        "typescript/consistent-indexed-object-style": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-utils.ts", "**/*.fixture.ts"],
      "rules": {
        "vitest/no-restricted-matchers": [
          "error",
          {
            "toMatchSnapshot": "Assert the specific outcome.",
            "toMatchInlineSnapshot": "Assert the specific outcome.",
            "toMatchFileSnapshot": "Assert the specific outcome.",
            "toThrowErrorMatchingSnapshot": "Assert the specific error.",
            "toThrowErrorMatchingInlineSnapshot": "Assert the specific error."
          }
        ],
        "vitest/no-restricted-vi-methods": [
          "error",
          {
            "waitFor": "Await the real event.",
            "waitUntil": "Await the real event.",
            "setConfig": "Make the test fast instead of raising its timeout."
          }
        ]
      }
    },
    {
      "files": ["scripts/**", "**/.claude/skills/**"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/consistent-return": "off",
        "typescript/consistent-type-exports": "off",
        "typescript/dot-notation": "off",
        "typescript/no-array-delete": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-deprecated": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-for-in-array": "off",
        "typescript/no-generated-empty-object-type": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-meaningless-void-operator": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-misused-spread": "off",
        "typescript/no-mixed-enums": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-qualifier": "off",
        "typescript/no-unnecessary-template-expression": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-enum-assignment": "off",
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-unary-minus": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/non-nullable-type-assertion-style": "off",
        "typescript/only-throw-error": "off",
        "typescript/prefer-find": "off",
        "typescript/prefer-includes": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/prefer-optional-chain": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/prefer-readonly": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        "typescript/prefer-reduce-type-parameter": "off",
        "typescript/prefer-regexp-exec": "off",
        "typescript/prefer-return-this-type": "off",
        "typescript/prefer-string-starts-ends-with": "off",
        "typescript/promise-function-async": "off",
        "typescript/related-getter-setter-pairs": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/require-await": "off",
        "typescript/restrict-plus-operands": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/return-await": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/strict-void-return": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "typescript/unbound-method": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "node/no-sync": "off",
        "standard/no-typeof": "off"
      }
    }
  ]
}
